{
  "templates": [
    {
      "name": "homepage",
      "urls": [
        "https://www.gigamon.com/"
      ],
      "description": "Gigamon corporate homepage with hero carousel, product highlights, customer testimonials, and promotional content",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            "div.carousel > section.component-carousel.whitearrows.move-dots-up"
          ]
        },
        {
          "name": "logo-marquee",
          "instances": [
            "div.experiencefragment > div.xf-content-height div.component-background.medium-gray-5-bg section.component-responsive-layout"
          ]
        },
        {
          "name": "columns-value-prop",
          "instances": [
            "div.responsive-layout > div.component-background.vert-pad-top-sm section.component-responsive-layout"
          ]
        },
        {
          "name": "tabs-spotlight",
          "instances": [
            "div.multi-tabs section.component-multi-tabs"
          ]
        },
        {
          "name": "cards-featured",
          "instances": [
            "div.columns > div.component-background.light-grey-bg div.container.anu-blade section.component-columns"
          ]
        },
        {
          "name": "columns-testimonials",
          "instances": [
            "div.columns > div.component-background.light-grey-bg:not(.vert-pad-top-lg) section.component-columns"
          ]
        },
        {
          "name": "columns-award",
          "instances": [
            "div.background-image > section.component-background-image"
          ]
        },
        {
          "name": "cards-resources",
          "instances": [
            "div.carousel > div.component-background section.component-carousel.grayarrows"
          ]
        },
        {
          "name": "hero-cta",
          "instances": [
            "section#ieedf375ef1e580bc427318e1a52ff9d0.component-mega-banner"
          ]
        },
        {
          "name": "embed-blog-feed",
          "instances": [
            "div.rss-feeds section.component-rss-feeds"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero Carousel",
          "selector": "div.carousel:first-of-type",
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Customer Logo Bar",
          "selector": "div.experiencefragment:first-of-type",
          "style": "grey",
          "blocks": [
            "logo-marquee"
          ],
          "defaultContent": [
            "p.tiletext"
          ]
        },
        {
          "id": "section-3",
          "name": "Why Gigamon",
          "selector": "div.responsive-layout.vert-pad-top-sm",
          "style": null,
          "blocks": [
            "columns-value-prop"
          ],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "Learn How Gigamon Can Help You",
          "selector": "div.multi-tabs",
          "style": null,
          "blocks": [
            "tabs-spotlight",
            "cards-featured"
          ],
          "defaultContent": [
            "section.component-text-jumbo"
          ]
        },
        {
          "id": "section-5",
          "name": "Customer Testimonials",
          "selector": "div.columns:has(.component-columns.not-flush):not(:has(.anu-blade))",
          "style": "grey",
          "blocks": [
            "columns-testimonials"
          ],
          "defaultContent": []
        },
        {
          "id": "section-6",
          "name": "Frost & Sullivan Award",
          "selector": "div.experiencefragment:has(.background-image)",
          "style": "dark",
          "blocks": [
            "columns-award"
          ],
          "defaultContent": []
        },
        {
          "id": "section-7",
          "name": "What's New",
          "selector": [
            "div.text-jumbo:has(#ie2b8fa95b2c89512ce15ed7e54e2ce29)",
            "div.carousel:has(.grayarrows)"
          ],
          "style": null,
          "blocks": [
            "cards-resources"
          ],
          "defaultContent": [
            "section#ie2b8fa95b2c89512ce15ed7e54e2ce29"
          ]
        },
        {
          "id": "section-8",
          "name": "Explore Real-World Use Cases",
          "selector": "div.mega-banner:has(#ieedf375ef1e580bc427318e1a52ff9d0)",
          "style": null,
          "blocks": [
            "hero-cta"
          ],
          "defaultContent": []
        },
        {
          "id": "section-9",
          "name": "Latest Blogs",
          "selector": [
            "div.text-jumbo:has(#i23bc43674b877a97c14aa12054d81997)",
            "div.rss-feeds"
          ],
          "style": null,
          "blocks": [
            "embed-blog-feed"
          ],
          "defaultContent": [
            "section#i23bc43674b877a97c14aa12054d81997"
          ]
        }
      ]
    }
  ]
}
